# Clave que usarás para entrar al panel de organizador en /admin
ADMIN_PASSWORD=cambia-esta-clave

# Esta variable la crea Vercel automáticamente cuando conectas un
# almacén Blob a tu proyecto (Storage → Create Database → Blob), usando
# el prefijo personalizado "FOTOS".
# No la escribas a mano en producción; para desarrollo local usa:
#   vercel link
#   vercel env pull .env.local
FOTOS_READ_WRITE_TOKEN=
